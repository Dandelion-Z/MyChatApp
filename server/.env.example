# MyChatApp 后端环境变量示例
# 复制为 .env 后填入真实值；.env 不会被提交到 Git。

PORT=3000
# Node 监听地址。默认 127.0.0.1，仅本机 Nginx 可访问；不要在生产环境改成 0.0.0.0。
HOST=127.0.0.1
DATABASE_URL=postgresql://USERNAME:PASSWORD@localhost:5432/mychatapp
# 允许的客户端来源，多个用逗号分隔；不支持通配符 * 或 null。
# http://localhost:5173 对应开发环境 Vite 页面，app://mychatapp 对应 Electron 生产页面。
CORS_ORIGIN=http://localhost:5173,app://mychatapp
